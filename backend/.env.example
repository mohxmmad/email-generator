DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOW_ALL_ORIGINS=True
# Optional: set this only if CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: if not set, app uses built-in local generator (no API key needed)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LOCAL_FALLBACK_ON_PROVIDER_ERROR=True
